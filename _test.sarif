        {
          "ruleId": "DF-001b",
          "level": "error",
          "message": {
            "text": "Base image without tag — When no tag is specified, Docker defaults to :latest, which makes builds non-reproducible."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///C:/Users/nacho/Documents/GitHub/Docker-Hardening-Checker/samples/Dockerfile.bad",
                  "uriBaseId": "%SRCROOT%"
